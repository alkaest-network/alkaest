  "canonicalization": [
    {
      "id": "jcs-rfc8785-number-string-literals",
      "inputJson": "{\"numbers\":[333333333.33333329,1E30,4.50,2e-3,0.000000000000000000000000001],\"string\":\"\\u20ac$\\u000f\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\"literals\":[null,true,false]}",
      "expectedCanonicalUtf8": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
      "expectedSha256": "2d5e01a318d0f0879ab568c4be289c8b1f64ef8921a53c6277d5e069978baacb"
    },
    {
      "id": "jcs-rfc8785-property-sort-utf16",
      "inputJson": "{\"€\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"1\":\"One\",\"😀\":\"Emoji: Grinning Face\",\"\u0080\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\"}",
      "expectedPropertyOrder": ["\\r", "1", "\u0080", "ö", "€", "😀", "\ufb33"]
    },
    {
      "id": "reject-duplicate-property",
      "inputJson": "{\"a\":1,\"a\":2}",
      "expected": "reject-before-signature-or-state-processing"
    },
    {
      "id": "reject-lone-surrogate",
      "inputJson": "{\"x\":\"\\ud800\"}",
      "expected": "reject-invalid-unicode"
    },
    {
      "id": "jcs-negative-zero",
      "inputJson": "{\"negativeZero\":-0.0}",
      "expectedCanonicalUtf8": "{\"negativeZero\":0}",
      "expectedSha256": "4b56f0ef8f7c714c60f377637eec1bcf07aabf03fd7bf20ea5ea57688b9fac18"
    },
    {
      "id": "reject-non-finite-binary64-number",
      "inputJson": "{\"value\":1e400}",
      "expected": "reject-non-finite-number-before-signature-or-state-processing"
    },
    {
      "id": "reject-unsafe-integer-amount-number",
      "inputJson": "{\"amountSats\":9007199254740993}",
      "expected": "reject-schema-unsafe-integer-number-use-decimal-string"
    }
  ],
